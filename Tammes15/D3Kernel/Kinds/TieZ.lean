  · exact tieMid_eq0 i l
  · exact tieMid_eq1 i l
  · exact tieMid_eq2 i l
  · exact tieMid_eq3 i l
  · exact tieMid_eq4 i l
  · exact tieMid_eq5 i l
  · exact tieMid_eq6 i l
  · exact tieMid_eq7 i l

theorem tieRad_eq (c : Fin 8) (i : Fin 15) (l : Fin 3) : tieRad c i l = 1 / 10 ^ 38 := by
  fin_cases c <;> fin_cases i <;> fin_cases l <;> norm_num [tieRad]

end Tammes15.D3Kernel.Kinds
