  · exact absurd hij (by decide)
  · exact absurd hij (by decide)
  · exact absurd hij (by decide)

theorem attained_of (hu : 1 / 2 < uR ∧ uR < 7 / 10) (hq : quintic uR = 0)
    (h1u : ∀ i, ‖frameC1.p i‖ = 1)
    (h1c : ∀ ij ∈ frameC1.S, ij.1 ≠ ij.2 ∧ ⟪frameC1.p ij.1, frameC1.p ij.2⟫ = uR)
    (h1s : ∀ i j, i ≠ j → ⟪frameC1.p i, frameC1.p j⟫ ≤ uR)
    (h3u : ∀ i, ‖frameC3.p i‖ = 1)
    (h3c : ∀ ij ∈ frameC3.S, ij.1 ≠ ij.2 ∧ ⟪frameC3.p ij.1, frameC3.p ij.2⟫ = uR)
    (h3s : ∀ i j, i ≠ j → ⟪frameC3.p i, frameC3.p j⟫ ≤ uR) :
    AttainedHyp {frameC1, frameC3} := by
  refine ⟨?_, uR, hu.1, hu.2, hq, ?_⟩
  · exact ⟨frameC1, by simp⟩
  · intro q hq_mem
    have hq_cases : q = frameC1 ∨ q = frameC3 := by
      simpa using hq_mem
    rcases hq_cases with (rfl | rfl)
    · exact ⟨h1u, h1c, h1s⟩
    · exact ⟨h3u, h3c, h3s⟩

/-- D4 for `F = {frameC1, frameC3}`. -/
theorem attained : AttainedHyp {frameC1, frameC3} :=
  attained_of (bounds_of_mem uR uR_spec.1) uR_spec.2 frameC1_unit frameC1_contact frameC1_sep
    frameC3_unit frameC3_contact frameC3_sep

end Tammes15.Attained
