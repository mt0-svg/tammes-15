import Tammes15.Attained.Roots
import Tammes15.Attained.Points
import Tammes15.Attained.Ident
import Tammes15.Attained.Sep

/-!
# D4 for the frames C1 and C3

`attained : AttainedHyp {frameC1, frameC3}`: both frames are 15 unit vectors whose 30 listed pairs
have inner product exactly `uR`, the root of the quintic, and whose other pairs have inner product at
most `uR`. The case lemmas are the generated `nm_k`, `ct_k1_k2`, `sp_k1_k2` at `(bR, uR)`.
-/

set_option maxHeartbeats 400000

open scoped RealInnerProductSpace

namespace Tammes15.Attained

theorem frameC1_S_ne : ∀ ij ∈ frameC1.S, ij.1 ≠ ij.2 := by
  unfold frameC1; set_option maxRecDepth 200000 in decide

theorem frameC3_S_ne : ∀ ij ∈ frameC3.S, ij.1 ≠ ij.2 := by
  unfold frameC3; set_option maxRecDepth 200000 in decide

theorem frameC1_unit : ∀ i, ‖frameC1.p i‖ = 1 := by
  intro i
  fin_cases i
  · exact norm_pt bR uR 0 (nm_0 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 1 (nm_1 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 2 (nm_2 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 3 (nm_3 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 4 (nm_4 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 5 (nm_5 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 6 (nm_6 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 7 (nm_7 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 10 (nm_10 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 12 (nm_12 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 13 (nm_13 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 14 (nm_14 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 15 (nm_15 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 16 (nm_16 bR uR uR_spec.2 bR_spec.2)
  · exact norm_pt bR uR 17 (nm_17 bR uR uR_spec.2 bR_spec.2)

theorem frameC1_contact : ∀ ij ∈ frameC1.S,
    ij.1 ≠ ij.2 ∧ ⟪frameC1.p ij.1, frameC1.p ij.2⟫ = uR := by
  intro ij hij
  refine ⟨frameC1_S_ne ij hij, ?_⟩
  dsimp [frameC1] at hij ⊢
  simp only [Finset.mem_insert, Finset.mem_singleton] at hij
  rcases hij with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
