theorem sumL : Lamn.sum ≤ 1043 * 2 ^ 64 := by decide +kernel

theorem sumM : (Mun.map List.sum).sum ≤ 20496 * 2 ^ 64 := by decide +kernel

theorem sumK : ((dLL oM Mkn).map fun r => (r.map Int.natAbs).sum).sum ≤ 95078 * 2 ^ 64 := by
  decide +kernel

theorem sums : ∑ e, lamOf Lamn e ≤ 1043 ∧ ∑ e, ∑ f, muOf Mun e f ≤ 20496 ∧
    ∑ k, ∑ b, |mkOf (dLL oM Mkn) k b| ≤ 95078 := by
  obtain ⟨-, -, -, -, hL, hM, hM', hK, hK'⟩ := shape
  refine ⟨?_, ?_, ?_⟩
  · rw [sum_lamOf _ hL, div_le_iff₀ (by positivity)]
    exact le_trans (Nat.cast_le.mpr sumL) (le_of_eq (by norm_num))
  · rw [sum_muOf _ hM hM', div_le_iff₀ (by positivity)]
    exact le_trans (Nat.cast_le.mpr sumM) (le_of_eq (by norm_num))
  · rw [sum_abs_mkOf _ hK hK', div_le_iff₀ (by positivity)]
    exact le_trans (Nat.cast_le.mpr sumK) (le_of_eq (by norm_num))

end Tammes15.Kappa.C3
